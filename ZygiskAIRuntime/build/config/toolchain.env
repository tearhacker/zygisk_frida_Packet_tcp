# 本机构建工具链路径（2026-09-19 实机遍历探测所得）
#
# 背景：这些工具**本来就在机器上**，只是没进 PATH，导致 P-1 首次审计误判为「全缺」。
# 本文件把实测路径固化下来，避免 M1 时再次找不到。
#
# 用法（Git Bash）：
#   source build/config/toolchain.env
#   "$ANDROID_NDK_HOME/build/cmake/android.toolchain.cmake" ...
#
# ⚠️ Windows 原生程序（cmake.exe / ninja.exe）必须传 **Windows 风格路径**（D:/...），
#    传 Git Bash 的 /d/... 形式会报 "no such file or directory"。

# --- Android NDK -----------------------------------------------------------
# 实机版本：r27d (27.3.13750724)，clang 18.0.4
# 满足项目要求（r27c+）；含 ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES（Android 15+ 16KB 页）
export ANDROID_NDK_HOME="D:/ProgramerDevelop/windowsNDK27"

# 另一个更旧的 NDK，仅作备查，**不要用于本项目**：
#   D:/ProgramerDevelop/ndk23  = r23.2，clang 12.0.9
#   不满足 LSPlant 的 C++23 + C++20 modules 要求

# --- CMake -----------------------------------------------------------------
# Visual Studio Professional 2026 自带，版本 4.3.1（≥ LSPlant 要求的 3.28）
export CMAKE_EXE="D:/ProgramerDevelop/VS2026/SDK/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe"

# --- Ninja -----------------------------------------------------------------
# 同上，VS 自带
export NINJA_EXE="D:/ProgramerDevelop/VS2026/SDK/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"

# --- Meson -----------------------------------------------------------------
# 唯一需要安装的：pip 装进 venv，**不污染系统**
export MESON_EXE="C:/Users/52334/.workbuddy-ai/binaries/python/envs/default/Scripts/meson.exe"
export PYTHON_VENV="C:/Users/52334/.workbuddy-ai/binaries/python/envs/default/Scripts/python.exe"

# --- ADB / JDK -------------------------------------------------------------
export ADB_EXE="C:/Program Files/platform-tools/adb.exe"
export JAVA_HOME="C:/Program Files/Java/jdk-21.0.11"

# --- Android SDK -----------------------------------------------------------
export ANDROID_SDK_ROOT="C:/Users/52334/AppData/Local/Android/Sdk"

# --- MSVC（build machine 编译器）-------------------------------------------
# meson 交叉编译 frida-gum 时，需要一台"能编译本机 Windows 程序"的 C 编译器
# （frida-gum/meson.build:404 无条件 dependency('glib-2.0', native: true)）。
# 本机没有 gcc/MinGW，只有 MSVC，但：
#   1. Windows SDK **不在 C 盘**，在 D:/Windows Kits/10（10.0.26100.0）
#   2. vcvarsall.bat 跑不了（沙箱禁 cmd.exe）→ INCLUDE / LIB 必须手动拼
# 这两个环境变量必须 export，cl.exe 才能找到 stdio.h / windows.h。
export MSVC_TOOLS="D:/ProgramerDevelop/VS2026/SDK/VC/Tools/MSVC/14.51.36231"
export MSVC_BIN="$MSVC_TOOLS/bin/Hostx64/x64"
export WIN_KITS="D:/Windows Kits/10"
export WIN_KITS_VER="10.0.26100.0"
export INCLUDE="$MSVC_TOOLS/include;$WIN_KITS/Include/$WIN_KITS_VER/ucrt;$WIN_KITS/Include/$WIN_KITS_VER/um;$WIN_KITS/Include/$WIN_KITS_VER/shared"
export LIB="$MSVC_TOOLS/lib/x64;$WIN_KITS/Lib/$WIN_KITS_VER/ucrt/x64;$WIN_KITS/Lib/$WIN_KITS_VER/um/x64"

# --- 构建参数（与 build/config/versions.env 保持一致）-----------------------
export ZAI_ABI="arm64-v8a"
export ZAI_API_LEVEL="30"

# --- 验证 -----------------------------------------------------------------
# 端到端验证已于 2026-09-19 通过：
#   CMake 4.3.1 + Ninja 1.13.2 + NDK r27d → arm64-v8a ELF64 共享库
#   直接编译 C++23 到 aarch64 也通过（aarch64-linux-android30-clang++）
