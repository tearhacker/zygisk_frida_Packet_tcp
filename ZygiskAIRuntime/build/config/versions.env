# 版本单一源。改动必须同步：
#   ../VERSION.txt
#     （原名 ../VERSION。必须带 .txt 后缀：工程根目录在 target_include_directories 里，
#      Windows 文件系统大小写不敏感，无后缀的 VERSION 会被 C++20 标准头
#      #include <version> 抢先命中，导致 nullptr_t 等一整片编译错误。）
#   ../../docs/00-权威基线/SOURCE_LOCK.md
#   ../../docs/00-权威基线/LICENSES.md

FRIDA_GUM_VERSION=17.18.0
ZYGISK_API_VERSION=5
LSPLANT_REF=master

# 构建参数
ANDROID_API_LEVEL=30
PRIMARY_ABI=arm64-v8a
SUPPORTED_ABI="arm64-v8a"

# 🔴 LGPL-3.0 约束：LSPlant 必须 SHARED，不得改为 static。
LSPLANT_LINK_MODE=SHARED
