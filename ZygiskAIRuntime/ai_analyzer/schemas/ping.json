{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-analyzer.local/schemas/ping.json",
  "title": "PING",
  "description": "心跳请求。独立线程发送，不得阻塞普通命令。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "timestamp",
    "seq"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "协议版本"
    },
    "type": {
      "const": "PING"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "description": "毫秒时间戳"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    }
  }
}
